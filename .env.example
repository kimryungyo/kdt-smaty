SMART_DESK_ENVIRONMENT=development
SMART_DESK_LOG_LEVEL=INFO

SMART_DESK_SERVER__HOST=0.0.0.0
SMART_DESK_SERVER__PORT=9090
SMART_DESK_SERVER__WORKERS=1

SMART_DESK_MQTT__HOST=127.0.0.1
SMART_DESK_MQTT__PORT=1883
SMART_DESK_MQTT__CLIENT_ID=smart-desk-server
SMART_DESK_MQTT__KEEPALIVE_SECONDS=30
SMART_DESK_MQTT__OPERATION_TIMEOUT_SECONDS=5
SMART_DESK_MQTT__RECONNECT_INTERVAL_SECONDS=2

SMART_DESK_SERIAL__PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
SMART_DESK_SERIAL__BAUDRATE=115200
SMART_DESK_SERIAL__READ_TIMEOUT_SECONDS=0.2
SMART_DESK_SERIAL__RECONNECT_INTERVAL_SECONDS=1

SMART_DESK_DESK__MEASUREMENT_MIN_CM=73
SMART_DESK_DESK__MEASUREMENT_MAX_CM=118
SMART_DESK_DESK__OPERATION_MIN_CM=75
SMART_DESK_DESK__OPERATION_MAX_CM=115
SMART_DESK_DESK__HEIGHT_STALE_AFTER_SECONDS=1
SMART_DESK_DESK__CONTINUOUS_HOLD_MS=500
SMART_DESK_DESK__MANUAL_HOLD_MS=500
SMART_DESK_DESK__FINE_HOLD_MS=100
SMART_DESK_DESK__PULSE_REFRESH_INTERVAL_SECONDS=0.1
SMART_DESK_DESK__CONTROL_POLL_INTERVAL_SECONDS=0.05
SMART_DESK_DESK__MANUAL_WATCHDOG_SECONDS=0.6
SMART_DESK_DESK__TARGET_TIMEOUT_SECONDS=120
SMART_DESK_DESK__TARGET_TOLERANCE_CM=0.2
SMART_DESK_DESK__FINE_APPROACH_DISTANCE_CM=1.5
SMART_DESK_DESK__FINE_SETTLE_SECONDS=1
SMART_DESK_DESK__RELAY_STALE_AFTER_SECONDS=15
SMART_DESK_DESK__RELAY_ACK_TIMEOUT_SECONDS=1

SMART_DESK_VISION__ENABLED=false
SMART_DESK_VISION__FFMPEG_PATH=ffmpeg
SMART_DESK_VISION__USER_CAMERA_DEVICE=/dev/v4l/by-id/usb-Alcorlink_Corp._USB_2.0_Camera-video-index0
SMART_DESK_VISION__USER_RTSP_URL=rtsp://127.0.0.1:8554/user-cam
SMART_DESK_VISION__USER_INPUT_FORMAT=mjpeg
SMART_DESK_VISION__USER_WIDTH=1280
SMART_DESK_VISION__USER_HEIGHT=720
SMART_DESK_VISION__USER_FPS=15
SMART_DESK_VISION__POSTURE_CAMERA_DEVICE=/dev/v4l/by-id/usb-SunplusIT_Inc_ABKO_APC930_QHD_WEBCAM_CY2M20201014V0-video-index0
SMART_DESK_VISION__POSTURE_RTSP_URL=rtsp://127.0.0.1:8554/posture-cam
SMART_DESK_VISION__POSTURE_INPUT_FORMAT=mjpeg
SMART_DESK_VISION__POSTURE_WIDTH=1280
SMART_DESK_VISION__POSTURE_HEIGHT=720
SMART_DESK_VISION__POSTURE_FPS=15
SMART_DESK_VISION__RTSP_RECONNECT_INTERVAL_SECONDS=1

SMART_DESK_STORAGE__DATABASE_PATH=data/smart_desk.db

SMART_DESK_DASHBOARD__SERVE_FRONTEND=true
SMART_DESK_DASHBOARD__FRONTEND_DIRECTORY=frontend/dist
