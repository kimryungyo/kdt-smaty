SMART_DESK_ENVIRONMENT=development
SMART_DESK_LOG_LEVEL=INFO

SMART_DESK_SERVER__HOST=0.0.0.0
SMART_DESK_SERVER__PORT=9090
SMART_DESK_SERVER__WORKERS=1

SMART_DESK_MQTT__HOST=127.0.0.1
SMART_DESK_MQTT__PORT=1883
SMART_DESK_MQTT__CLIENT_ID=smart-desk-server
SMART_DESK_MQTT__KEEPALIVE_SECONDS=30
SMART_DESK_MQTT__OPERATION_TIMEOUT_SECONDS=5
SMART_DESK_MQTT__RECONNECT_INTERVAL_SECONDS=2

SMART_DESK_SERIAL__PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
SMART_DESK_SERIAL__BAUDRATE=115200
SMART_DESK_SERIAL__READ_TIMEOUT_SECONDS=0.2
SMART_DESK_SERIAL__RECONNECT_INTERVAL_SECONDS=1

# 틸팅 장비는 단계·속도 보정과 실물 안전 검증을 마친 뒤에만 활성화한다.
SMART_DESK_TILT__ENABLED=false
SMART_DESK_TILT__SERIAL_PORT=/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_B8:1F:3F:0C:F7:14-if00
SMART_DESK_TILT__BAUDRATE=115200
SMART_DESK_TILT__READ_TIMEOUT_SECONDS=0.2
SMART_DESK_TILT__WRITE_TIMEOUT_SECONDS=0.7
SMART_DESK_TILT__EVENT_TIMEOUT_SECONDS=1
SMART_DESK_TILT__RECONNECT_INTERVAL_SECONDS=1
SMART_DESK_TILT__MIN_LEVEL=0
SMART_DESK_TILT__MAX_LEVEL=4
SMART_DESK_TILT__MOVE_DUTY_PERCENT=100
SMART_DESK_TILT__LEVELS_FILE=data/tilt_levels.json
SMART_DESK_TILT__CALIBRATION_FILE=data/tilt_calibration.json

SMART_DESK_DESK__MEASUREMENT_MIN_CM=73
SMART_DESK_DESK__MEASUREMENT_MAX_CM=118
SMART_DESK_DESK__OPERATION_MIN_CM=75
SMART_DESK_DESK__OPERATION_MAX_CM=115
SMART_DESK_DESK__HEIGHT_STALE_AFTER_SECONDS=1
SMART_DESK_DESK__CONTINUOUS_HOLD_MS=500
SMART_DESK_DESK__MANUAL_HOLD_MS=500
SMART_DESK_DESK__FINE_HOLD_MS=350
SMART_DESK_DESK__MAX_FINE_PULSES=2
SMART_DESK_DESK__PULSE_REFRESH_INTERVAL_SECONDS=0.1
SMART_DESK_DESK__CONTROL_POLL_INTERVAL_SECONDS=0.05
SMART_DESK_DESK__MANUAL_WATCHDOG_SECONDS=0.6
SMART_DESK_DESK__TARGET_TIMEOUT_SECONDS=120
SMART_DESK_DESK__TARGET_TOLERANCE_CM=1.0
SMART_DESK_DESK__FINE_APPROACH_DISTANCE_CM=1.5
SMART_DESK_DESK__FINE_SETTLE_SECONDS=1.2
SMART_DESK_DESK__RELAY_STALE_AFTER_SECONDS=15
SMART_DESK_DESK__RELAY_ACK_TIMEOUT_SECONDS=6

# 실제 높이·relay 안전 검증이 끝난 운영 환경에서만 true로 설정한다.
SMART_DESK_AUTOMATION__EXECUTE_AUTOMATIC_MOVEMENTS=false
SMART_DESK_AUTOMATION__AUTO_REARM_DISTANCE_CM=1.5
SMART_DESK_AUTOMATION__AUTO_REARM_SECONDS=3
SMART_DESK_AUTOMATION__POSTURE_CONFIRMATION_SECONDS=1.0

SMART_DESK_MEDIA__RECONNECT_INTERVAL_SECONDS=1
SMART_DESK_MEDIA__USER__PUBLISH_ENABLED=true
SMART_DESK_MEDIA__USER__RECEIVE_ENABLED=true
SMART_DESK_MEDIA__USER__DEVICE=/dev/v4l/by-id/usb-Alcorlink_Corp._USB_2.0_Camera-video-index0
SMART_DESK_MEDIA__USER__PUBLISH_URL=http://127.0.0.1:8889/user-cam/whip
SMART_DESK_MEDIA__USER__RECEIVE_URL=http://127.0.0.1:8889/user-cam/whep
SMART_DESK_MEDIA__USER__INPUT_FORMAT=mjpeg
SMART_DESK_MEDIA__USER__WIDTH=1920
SMART_DESK_MEDIA__USER__HEIGHT=1080
SMART_DESK_MEDIA__USER__FPS=15
SMART_DESK_MEDIA__WORKSPACE__PUBLISH_ENABLED=true
SMART_DESK_MEDIA__WORKSPACE__RECEIVE_ENABLED=false
SMART_DESK_MEDIA__WORKSPACE__DEVICE=/dev/v4l/by-id/usb-SunplusIT_Inc_ABKO_APC930_QHD_WEBCAM_CY2M20201014V0-video-index0
SMART_DESK_MEDIA__WORKSPACE__PUBLISH_URL=http://127.0.0.1:8889/workspace-cam/whip
SMART_DESK_MEDIA__WORKSPACE__RECEIVE_URL=http://127.0.0.1:8889/workspace-cam/whep
SMART_DESK_MEDIA__WORKSPACE__INPUT_FORMAT=mjpeg
SMART_DESK_MEDIA__WORKSPACE__WIDTH=2592
SMART_DESK_MEDIA__WORKSPACE__HEIGHT=1944
SMART_DESK_MEDIA__WORKSPACE__FPS=15
SMART_DESK_MEDIA__POSTURE__PUBLISH_ENABLED=false
SMART_DESK_MEDIA__POSTURE__RECEIVE_ENABLED=true
SMART_DESK_MEDIA__POSTURE__DEVICE=/dev/posture-cam
SMART_DESK_MEDIA__POSTURE__PUBLISH_URL=http://127.0.0.1:8889/posture-cam/whip
SMART_DESK_MEDIA__POSTURE__RECEIVE_URL=http://127.0.0.1:8889/bottom-cam/whep
SMART_DESK_MEDIA__POSTURE__INPUT_FORMAT=mjpeg
SMART_DESK_MEDIA__POSTURE__WIDTH=1280
SMART_DESK_MEDIA__POSTURE__HEIGHT=720
SMART_DESK_MEDIA__POSTURE__FPS=15

# 선택 하단 YOLO pose 모델. 빈 경로면 detector를 비활성(Noop, MODEL_UNAVAILABLE)으로 둔다.
SMART_DESK_VISION__MAX_CAMERA_SKEW_SECONDS=0.75
SMART_DESK_VISION__FRAME_STALE_AFTER_SECONDS=3.0
SMART_DESK_VISION__RESULT_STALE_AFTER_SECONDS=3.0
SMART_DESK_VISION__POSTURE_TRANSITION_SAMPLES=3
SMART_DESK_VISION__POSTURE_TRANSITION_REQUIRED_SAMPLES=2
SMART_DESK_VISION__POSTURE_UNKNOWN_SAMPLES=6
SMART_DESK_VISION__POSTURE_RECOVERY_SAMPLES=2
SMART_DESK_VISION__STABILITY_MAJORITY_RATIO=0.70
SMART_DESK_VISION__STABILITY_MIN_SAMPLES=3
SMART_DESK_VISION__LOWER_POSE_MODEL_PATH=
SMART_DESK_VISION__UPPER_INFERENCE_INTERVAL_SECONDS=0.5
SMART_DESK_VISION__LOWER_INFERENCE_INTERVAL_SECONDS=0.5
SMART_DESK_VISION__LOWER_POSE_INPUT_SIZE=640
SMART_DESK_VISION__LOWER_POSE_MIN_PERSON_CONFIDENCE=0.30
SMART_DESK_VISION__UPPER_PRESENCE_MIN_PERSON_CONFIDENCE=0.60
SMART_DESK_VISION__LOWER_POSE_MIN_HIP_CONFIDENCE=0.08
SMART_DESK_VISION__LOWER_POSE_MIN_KNEE_ANKLE_CONFIDENCE=0.45
SMART_DESK_VISION__LOWER_POSE_DECISION_THRESHOLD=0.52

# Docker의 stateless Vision service를 사용할 때 Main이 HTTP로 최신 분석 결과를 요청한다.
SMART_DESK_VISION_CLIENT__ENABLED=false
SMART_DESK_VISION_CLIENT__BASE_URL=http://127.0.0.1:9091
SMART_DESK_VISION_CLIENT__API_TOKEN=
SMART_DESK_VISION_CLIENT__POLL_INTERVAL_SECONDS=0.5
SMART_DESK_VISION_CLIENT__REQUEST_TIMEOUT_SECONDS=2.5
SMART_DESK_VISION_SERVER__HOST=0.0.0.0
SMART_DESK_VISION_SERVER__PORT=9091
SMART_DESK_VISION_SERVER__API_TOKEN=

# Local OpenCV Zoo files only; empty paths leave the respective adapter unavailable.
# These are calibration candidates, not site-validated production thresholds.
SMART_DESK_FACE__DETECTOR_MODEL_PATH=
SMART_DESK_FACE__EMBEDDING_MODEL_PATH=
SMART_DESK_FACE__DETECTOR_SCORE_THRESHOLD=0.85
SMART_DESK_FACE__DETECTOR_NMS_THRESHOLD=0.3
SMART_DESK_FACE__MIN_FACE_SIZE=64
SMART_DESK_FACE__MIN_BLUR_VARIANCE=30
SMART_DESK_FACE__MIN_BRIGHTNESS=35
SMART_DESK_FACE__MAX_BRIGHTNESS=220
SMART_DESK_FACE__MATCH_THRESHOLD=0.363
SMART_DESK_FACE__BEST_SECOND_MARGIN=0.04
SMART_DESK_FACE__PAIRWISE_CONSISTENCY_THRESHOLD=0.363
SMART_DESK_FACE__DUPLICATE_THRESHOLD=0.45
SMART_DESK_FACE__ENROLLMENT_SAMPLE_INTERVAL_SECONDS=0.5

SMART_DESK_STORAGE__DATABASE_PATH=data/smart_desk.db

SMART_DESK_PROFILE_MEMORY__ENABLED=false
SMART_DESK_PROFILE_MEMORY__DATA_PATH=data/mem0
SMART_DESK_PROFILE_MEMORY__HISTORY_DB_PATH=data/mem0/history.db
SMART_DESK_PROFILE_MEMORY__COLLECTION_NAME=smart_desk_profile_memory_v1
SMART_DESK_PROFILE_MEMORY__EMBEDDING_MODEL=text-embedding-3-small
SMART_DESK_PROFILE_MEMORY__EMBEDDING_DIMENSIONS=1536
SMART_DESK_PROFILE_MEMORY__SEARCH_LIMIT=5
SMART_DESK_PROFILE_MEMORY__TIMEOUT_SECONDS=2
SMART_DESK_PROFILE_MEMORY__WRITE_TIMEOUT_SECONDS=8
SMART_DESK_PROFILE_MEMORY__FACT_LIMIT=500
SMART_DESK_PROFILE_MEMORY__CIRCUIT_FAILURE_THRESHOLD=3
SMART_DESK_PROFILE_MEMORY__CIRCUIT_OPEN_SECONDS=30

# Mem0 OSS가 import 시 생성하는 runtime configuration의 영속 경로와 telemetry 정책.
MEM0_DIR=data/mem0/runtime
MEM0_TELEMETRY=false

SMART_DESK_DASHBOARD__SERVE_FRONTEND=true
SMART_DESK_DASHBOARD__FRONTEND_DIRECTORY=frontend/dist

SMART_DESK_WLED__ENABLED=false
SMART_DESK_WLED__BASE_URL=http://wled.local
SMART_DESK_WLED__TIMEOUT_SECONDS=2

SMART_DESK_OPENAI__API_KEY=
SMART_DESK_OPENAI__RESPONSE_MODEL=gpt-5.6-terra

SMART_DESK_VOICE__ENABLED=false
SMART_DESK_VOICE__INPUT_DEVICE_NAME=
SMART_DESK_VOICE__OUTPUT_DEVICE_NAME=
SMART_DESK_VOICE__WAKEWORD_MODEL_PATH=assets/voice/models/hi_smarty_ko_synthetic_v0_1_0.onnx
SMART_DESK_VOICE__WAKEWORD_THRESHOLD=0.35
SMART_DESK_VOICE__WAKEWORD_CONSECUTIVE_FRAMES=1
SMART_DESK_VOICE__WAKEWORD_INFERENCE_INTERVAL_FRAMES=5
SMART_DESK_VOICE__SILENCE_RMS_THRESHOLD=500
SMART_DESK_VOICE__SPEECH_START_TIMEOUT_SECONDS=3
SMART_DESK_VOICE__FOLLOWUP_ENABLED=true
SMART_DESK_VOICE__FOLLOWUP_TIMEOUT_SECONDS=4
SMART_DESK_VOICE__FOLLOWUP_PREROLL_SECONDS=0.3
SMART_DESK_VOICE__POST_PLAYBACK_GUARD_SECONDS=1
SMART_DESK_VOICE__INPUT_QUEUE_FRAMES=64
SMART_DESK_VOICE__SESSION_HISTORY_ITEM_CAP=24
SMART_DESK_VOICE__ACKNOWLEDGEMENT_EFFECT_PATH=assets/voice/effects/acknowledgement.wav
SMART_DESK_VOICE__ERROR_EFFECT_PATH=assets/voice/effects/error.wav

# 임시 AI 스피커 디버그 페이지. local Voice/Wake Word/audio telemetry만 표시한다.
SMART_DESK_VOICE_DEBUG__ENABLED=false
SMART_DESK_VOICE_DEBUG__HOST=127.0.0.1
SMART_DESK_VOICE_DEBUG__PORT=10000
